# ===== 공통 =====
ENV=local                       # local | vm
LOG_LEVEL=INFO
TZ=UTC

# ===== Kafka =====
KAFKA_BOOTSTRAP=localhost:9092  # VM: kafka1:9092,kafka2:9092,kafka3:9092
KAFKA_CONNECT_URL=http://localhost:8083

# ===== MariaDB =====
MARIADB_HOST=localhost          # VM 쓰기: mariadb-p / 읽기: mariadb-r
MARIADB_READ_HOST=localhost
MARIADB_PORT=3306
MARIADB_DB=gamenuri
MARIADB_USER=gamenuri
MARIADB_PASSWORD=

# ===== MongoDB =====
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=gamenuri_raw

# ===== Elasticsearch =====
ES_URL=http://localhost:9200

# ===== Valkey =====
VALKEY_URL=redis://localhost:6379/0

# ===== 외부 API =====
ITAD_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_KEY=

# ===== 수집 =====
COLLECT_PRICE_INTERVAL_MIN=360  # 6시간
DANAWA_REQUEST_DELAY_SEC=3

# ===== Backend =====
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
