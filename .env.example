# ===== 공통 =====
ENV=local                       # local | vm
LOG_LEVEL=INFO
SERVER_NAME=
TZ=UTC

# ===== Kafka =====
KAFKA_BOOTSTRAP=localhost:9092  # VM: kafka1:9092,kafka2:9092,kafka3:9092
KAFKA_CONNECT_URL=http://localhost:8083

# ===== MariaDB =====
MARIADB_HOST=localhost          # VM 쓰기: mariadb-pr / 읽기: mariadb-re
MARIADB_READ_HOST=localhost
MARIADB_PORT=3306
MARIADB_DB=gamenuri
MARIADB_USER=gamenuri
MARIADB_PASSWORD=

# ===== MongoDB =====
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0  # VM: mongodb://<계정>:<비밀번호>@mongodb-pr:27017,mongo-se1:27017,mongo-se2:27017/?replicaSet=rs0&authSource=admin
MONGO_DB=gamenuri_raw

# ===== Elasticsearch =====
ES_URL=http://localhost:9200    # VM: http://elk:9200

# ===== Valkey =====
VALKEY_URL=redis://localhost:6379/0  # VM: redis://valkey:6379/0

# ===== 외부 API =====
ITAD_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_KEY=

# ===== 수집 =====
COLLECT_PRICE_INTERVAL_MIN=360  # 6시간
DANAWA_REQUEST_DELAY_SEC=3

# ===== 공개 주소 · 구글 로그인 =====
PUBLIC_BASE_URL=https://example.ddns.net
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.ddns.net/api/auth/google/callback

# ===== AI (⑤ 리뷰 요약, ⑥ 사양 비교) =====
GEMINI_API_KEY=
AI_MODEL=

# ===== 메일 (Gmail SMTP 앱 비밀번호) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ===== Backend =====
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173

# 개발 전용. 로그인 없이 가짜 사용자로 동작한다. 배포 .env에는 반드시 false
AUTH_FAKE_USER=false
# 가짜 사용자가 쓸 user_id. users 테이블에 실제로 있어야 한다 (FK)
AUTH_FAKE_USER_ID=1