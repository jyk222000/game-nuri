{
  "name": "mongo-sink-raw",
  "config": {
    "connector.class": "com.mongodb.kafka.connect.MongoSinkConnector",
    "topics": "raw.price,raw.console,raw.steam,raw.igdb",
    "connection.uri": "${MONGO_URI}",
    "database": "gamenuri_raw",
    "collection": "raw_unknown",
    "topic.override.raw.price.collection": "raw_itad",
    "topic.override.raw.console.collection": "raw_danawa",
    "topic.override.raw.steam.collection": "raw_steam",
    "topic.override.raw.igdb.collection": "raw_igdb",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "tasks.max": "3",
    "transforms": "skipReview,ingested,ingestedDate",
    "transforms.skipReview.type": "io.confluent.connect.transforms.Filter$Value",
    "transforms.skipReview.filter.condition": "$[?(@.kind == 'review')]",
    "transforms.skipReview.filter.type": "exclude",
    "transforms.skipReview.missing.or.null.behavior": "include",
    "transforms.ingested.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.ingested.timestamp.field": "ingested_at",
    "transforms.ingestedDate.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.ingestedDate.field": "ingested_at",
    "transforms.ingestedDate.target.type": "Timestamp",
    "max.num.retries": "3",
    "retries.defer.timeout": "5000"
  }
}
