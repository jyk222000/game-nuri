{
  "name": "mongo-sink-reviews",
  "config": {
    "_comment": "raw.steam 중 kind=review(리뷰 1건 = 메시지 1개, #53)만 gamenuri_raw.reviews에 저장. payload.recommendationid 기준 upsert라 같은 리뷰를 다시 받아도 한 건. 필터는 Confluent connect-transforms 플러그인 필요",
    "connector.class": "com.mongodb.kafka.connect.MongoSinkConnector",
    "topics": "raw.steam",
    "connection.uri": "${MONGO_URI}",
    "database": "gamenuri_raw",
    "collection": "reviews",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "onlyReview,ingested,ingestedDate",
    "transforms.onlyReview.type": "io.confluent.connect.transforms.Filter$Value",
    "transforms.onlyReview.filter.condition": "$[?(@.kind == 'review')]",
    "transforms.onlyReview.filter.type": "include",
    "transforms.onlyReview.missing.or.null.behavior": "exclude",
    "transforms.ingested.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.ingested.timestamp.field": "ingested_at",
    "transforms.ingestedDate.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.ingestedDate.field": "ingested_at",
    "transforms.ingestedDate.target.type": "Timestamp",
    "document.id.strategy": "com.mongodb.kafka.connect.sink.processor.id.strategy.PartialValueStrategy",
    "document.id.strategy.partial.value.projection.type": "AllowList",
    "document.id.strategy.partial.value.projection.list": "payload.recommendationid",
    "writemodel.strategy": "com.mongodb.kafka.connect.sink.writemodel.strategy.ReplaceOneBusinessKeyStrategy",
    "tasks.max": "1",
    "max.num.retries": "3",
    "retries.defer.timeout": "5000"
  }
}
