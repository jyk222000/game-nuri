{
  "name": "mongo-sink-unmatched",
  "config": {
    "connector.class": "com.mongodb.kafka.connect.MongoSinkConnector",
    "topics": "refined.unmatched",
    "connection.uri": "${MONGO_URI}",
    "database": "gamenuri_raw",
    "collection": "unmatched",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "tasks.max": "1",
    "transforms": "ingested",
    "transforms.ingested.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.ingested.timestamp.field": "ingested_at",
    "max.num.retries": "3",
    "retries.defer.timeout": "5000"
  }
}
