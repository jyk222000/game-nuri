{
  "name": "jdbc-sink-games",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "connection.url": "jdbc:mariadb://mariadb-pr:3306/gamenuri",
    "dialect.name": "MySqlDatabaseDialect",
    "connection.user": "${MARIADB_USER}",
    "connection.password": "${MARIADB_PASSWORD}",
    "auto.create": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "topics": "refined.games",
    "table.name.format": "games",
    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "game_id",
    "transforms": "ts",
    "transforms.ts.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.ts.field": "updated_at",
    "transforms.ts.target.type": "Timestamp",
    "transforms.ts.format": "yyyy-MM-dd'T'HH:mm:ss",
    "tasks.max": "1"
  }
}
