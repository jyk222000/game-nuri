{
  "uid": "gamenuri-db",
  "title": "겜누리 DB",
  "tags": [
    "gamenuri",
    "db"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "겜누리 종합",
      "type": "link",
      "url": "/d/gamenuri-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "겜누리 Kafka 상세",
      "type": "link",
      "url": "/d/gamenuri-kafka",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": false
    },
    {
      "title": "겜누리 로그",
      "type": "link",
      "url": "/d/gamenuri-logs",
      "icon": "dashboard",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "데이터 소스",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "한눈에 보는 상태",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "MariaDB 원본 (mariadb-pr)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(mysql_up{instance=\"mariadb-pr:9104\"}) or vector(-1)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "확인 불가",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "정상",
                  "color": "green"
                },
                "0": {
                  "text": "꺼짐",
                  "color": "red"
                },
                "-1": {
                  "text": "확인 불가",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
