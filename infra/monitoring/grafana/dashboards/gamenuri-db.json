    {
      "id": 8,
      "type": "stat",
      "title": "MongoDB 3대 역할 (PRIMARY는 파랑)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (instance) (mongodb_mongod_replset_my_state) or max by (instance) (up{job=\"mongodb\"} * 0 - 1)",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "확인 불가",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "PRIMARY",
                  "color": "blue"
                },
                "2": {
                  "text": "SECONDARY",
                  "color": "green"
                },
                "-1": {
                  "text": "꺼짐",
                  "color": "red"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 3,
                "to": 99,
                "result": {
                  "text": "이상 상태",
                  "color": "orange"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0,
                "result": {
                  "text": "시작 중",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
