# /etc/game-nuri/collector.env (수집 서버 proxy, root:collector, 640). 실제 값은 서버에만 넣고 커밋하지 않는다.
ENV=vm
LOG_LEVEL=INFO
KAFKA_BOOTSTRAP=kafka1:9092,kafka2:9092,kafka3:9092
# IGDB (Twitch 앱 등록 값)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# IsThereAnyDeal
ITAD_KEY=
# Steam Web API 키. 보유 게임 등 키가 필요한 호출용 (사양·리뷰·동접자는 키 불필요). GetItems 필요 여부는 미확인
STEAM_KEY=
# 리뷰 요약 배치(python -m collector.review_summary, 손으로 실행)용. 값은 서버에만 넣는다.
# ES 주소. 빠뜨리면 기본값(localhost)이라 집계가 실패한다
ES_URL=http://elk:9200
# ES 로그인 계정·비밀번호 (elk의 ES는 로그인이 켜져 있다)
ES_USER=
ES_PASSWORD=
# Gemini API 키. 사양 판정(backend)과 같은 키·같은 프로젝트라서 무료 한도(하루 500회, 분당 15회)를 같이 쓴다
GEMINI_API_KEY=
# 사용할 모델 이름 (예: gemini-3.5-flash-lite)
AI_MODEL=
