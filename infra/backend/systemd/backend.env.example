# /etc/game-nuri/backend.env (backend1, backend2. root:backend, 640). 실제 값은 서버에만 넣고 커밋하지 않는다.
# 호스트는 IP가 아니라 호스트 이름(docs/network.md)을 쓴다.
ENV=vm
LOG_LEVEL=INFO
# SERVER_NAME: backend1 서버는 backend1, backend2 서버는 backend2 (/api/health, clickstream served_by에 찍힌다)
# 주의: systemd EnvironmentFile은 값 뒤의 "# ..." 주석을 지우지 않는다. 주석은 항상 별도 줄에 쓴다.
SERVER_NAME=backend1

# MariaDB — 쓰기·사용자 본인 데이터는 Primary, 일반 조회는 Replica(안 되면 Primary로 읽는다)
MARIADB_HOST=mariadb-pr
MARIADB_READ_HOST=mariadb-re
MARIADB_PORT=3306
MARIADB_DB=gamenuri
MARIADB_USER=
MARIADB_PASSWORD=

# Valkey — 세션·캐시. 비밀번호는 URL에 넣는다: redis://:<비밀번호>@valkey:6379/0
VALKEY_URL=

# Kafka — clickstream 발행
KAFKA_BOOTSTRAP=kafka1:9092,kafka2:9092,kafka3:9092

# Elasticsearch — /api/health 확인용 (ES 설치 후)
ES_URL=http://elk:9200

# Steam 연동(PUT /api/me/steam, GetOwnedGames) — 키는 여기에만
STEAM_KEY=

# 목표가 알림 메일(Gmail SMTP) — backend1에서만 쓴다. 값은 이 파일이 아니라 서버의 /etc/game-nuri/backend.env에만 넣는다
# SMTP_USER: 보내는 구글 계정(메일 주소). SMTP_PASSWORD: 구글 "앱 비밀번호"(계정 비밀번호가 아님, 2단계 인증을 켜야 발급)
# 앱 비밀번호는 화면에 4글자씩 띄어 보이지만 **공백 없이** 붙여서 넣는다(공백이 있으면 셸로 읽는 확인 명령이 깨진다)
# MAIL_FROM: 보낸 사람 표시(비우면 SMTP_USER). PUBLIC_BASE_URL: 메일 속 게임 링크의 앞부분(비우면 링크 없음)
# (systemd는 값 뒤 # 주석을 값으로 읽으므로 설명은 별도 줄에 둔다)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PUBLIC_BASE_URL=https://gamenuri.store

# API 사용 순위(#37) — Prometheus 주소. 비우면 순위는 degraded. (prometheus.yml에 backend :8000 /metrics job이 있어야 값이 나온다)
PROMETHEUS_URL=http://monitoring:9090

# 개발용 가짜 로그인. 구글 로그인(#1·#2)이 붙기 전 시험에만 true로, 시험이 끝나면 반드시 false.
# 구글 로그인 (값은 이 파일이 아니라 서버의 /etc/game-nuri/backend.env에만 넣는다)
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: 구글 Cloud 콘솔의 OAuth 클라이언트 값
# GOOGLE_REDIRECT_URI: 콘솔에 등록한 값과 한 글자도 다르면 안 된다 (예: https://gamenuri.store/api/auth/google/callback)
# SESSION_SECRET: 로그인 state 쿠키 서명용 긴 임의 문자열. backend1과 backend2가 같은 값이어야 한다
# (systemd는 값 뒤 # 주석을 값으로 읽으므로 설명은 별도 줄에 둔다)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SESSION_SECRET=

# 사양 적합도 판정(AI): 키는 이 파일이 아니라 서버의 /etc/game-nuri/backend.env에만 넣는다
# GEMINI_API_KEY: Gemini API 키. AI_MODEL: 사용할 모델 이름(예: gemini-3.5-flash-lite)
# 둘 중 하나라도 비어 있으면 /api/games/{id}/spec-check가 503을 돌려준다(화면은 사양 표만 보여 줌)
# (systemd는 값 뒤 # 주석을 값으로 읽으므로 설명은 별도 줄에 둔다)
GEMINI_API_KEY=
AI_MODEL=

# true이면 로그인 없이 AUTH_FAKE_USER_ID 사용자로 동작한다(users 테이블에 그 user_id가 있어야 한다).
AUTH_FAKE_USER=false
AUTH_FAKE_USER_ID=1
