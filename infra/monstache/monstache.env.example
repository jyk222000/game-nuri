# /etc/monstache/monstache.env 예시 (root:root 600). 실제 파일은 커밋하지 않는다.
# MongoDB 비밀번호에 @ : / ? # % 가 있으면 URL 인코딩한다 (@ → %40, : → %3A, # → %23, % → %25)
MONSTACHE_MONGO_URL=mongodb://monstache:<비밀번호>@mongodb-pr:27017,mongo-se1:27017,mongo-se2:27017/?replicaSet=rs0&authSource=admin
MONSTACHE_ES_USER=elastic
MONSTACHE_ES_PASS=<비밀번호>
